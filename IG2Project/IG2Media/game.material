material game/walls {
    technique { 
	pass {  
	    texture_unit {
            texture RustedMetal.jpg
		}
	}
    }
}

material game/intro_floor {
    technique { 
	pass {  
	    texture_unit {
            texture RustedMetal.jpg
          }
	}
    }
}

material game/labyrinth_floor {
    technique { 
	pass {  
	    texture_unit {
            texture grass.png
          }
	}
    }
}

material game/sky {
	technique {
		pass {
			lighting off
			texture_unit {
				texture spaceSky2.png
            	scroll_anim 0.015 0.008
			}
		}
	}
}

material game/tankBody {
    technique { 
	pass {  
	    texture_unit {
			texture tank.jpg
	    }
	}
    }
}

material game/tankTop {
    technique { 
	pass {  
	    texture_unit {
			texture tankTop.jpg
	    }
	}
    }
}

material game/bombBody {
	technique {
		pass {
			ambient 0.0	0.0	0.0	
			diffuse 0.01 0.01 0.01
			specular 0.50 0.50 0.50	.25
		}
	}
}

material game/bombFuse {
	technique {
		pass {
			ambient 0.2125 0.1275 0.054	
			diffuse 0.714 0.4284 0.18144
			specular 0.393548 0.271906 0.166721 0.2
		}
	}
}

material game/smoke {
    technique{
        pass{
            lighting off
            scene_blend alpha_blend
            depth_write off
            diffuse vertexcolour

            texture_unit{
                texture smoke.png
                tex_address_mode clamp
            }
        }
    }
}

material game/lavaFloor {
    technique{
       pass{
         texture_unit {
         	texture blackRock.jpg
         }

         texture_unit {
         	texture alphaMask.png
         	colour_op alpha_blend
         }

         texture_unit {
         	texture lava.jpg
            scroll_anim 0.015 0.008
         	colour_op_ex blend_current_alpha src_texture src_current
         }
       }
    }
 }

 //////////////////////////////////////////////
//// Sky with texture zooming
//////////////////////////////////////////////

vertex_program game/spaceSkyZoomVS glsl{

    source spaceSkyZoomVS.glsl
    default_params{
       param_named_auto modelViewProjectionMatrix worldviewproj_matrix
       param_named_auto timeZoom sintime_0_2pi 16
    }
}

fragment_program game/spaceSkyZoomFS glsl{

    source spaceSkyZoomFS.glsl
    default_params{
       param_named tex0 int 0
	   param_named tex1 int 1
    }
}

material game/spaceSkyZoomShader{

    technique{
    
        pass{
                vertex_program_ref game/spaceSkyZoomVS {
                }
                
                fragment_program_ref game/spaceSkyZoomFS {
                }
                
                texture_unit {
                    texture lightMap.jpg
					tex_address_mode clamp
                }

				texture_unit {
                    texture spaceSky2.png
					tex_address_mode clamp
                }
            }
    }
}