material game/walls {
    technique { 
	pass {  
	    texture_unit {
            texture RustedMetal.jpg
		}
	}
    }
}

material game/intro_floor {
    technique { 
	pass {  
	    texture_unit {
            texture RustedMetal.jpg
          }
	}
    }
}

material game/labyrinth_floor {
    technique { 
	pass {  
	    texture_unit {
            texture grass.png
          }
	}
    }
}

material game/sky {
	technique {
		pass {
			lighting off
			texture_unit {
				texture spaceSky.jpg
			}
		}
	}
}

material game/tankBody {
    technique { 
	pass {  
	    texture_unit {
			texture tank.jpg
	    }
	}
    }
}

material game/tankTop {
    technique { 
	pass {  
	    texture_unit {
			texture tankTop.jpg
	    }
	}
    }
}

material game/bombBody {
	technique {
		pass {
			ambient 0.0	0.0	0.0	
			diffuse 0.01 0.01 0.01
			specular 0.50 0.50 0.50	.25
		}
	}
}

material game/bombFuse {
	technique {
		pass {
			ambient 0.2125 0.1275 0.054	
			diffuse 0.714 0.4284 0.18144
			specular 0.393548 0.271906 0.166721 0.2
		}
	}
}

material game/smoke {
    technique{
        pass{
            lighting off
            scene_blend alpha_blend
            depth_write off
            diffuse vertexcolour

            texture_unit{
                texture smoke.png
                tex_address_mode clamp
            }
        }
    }
}