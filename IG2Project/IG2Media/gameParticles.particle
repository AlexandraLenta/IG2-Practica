particle_system game/fuseParticle{
    billboard_type point
    material game/smoke
    particle_width 1
    particle_height 1
    quota 500

    emitter Point{
        position 0 0 0
        direction 0 1 0
        angle 10
        emission_rate 6
        time_to_live 2
        velocity_min 20
        velocity_max 28
        duration 0
    }

    affector ColourImage {
        image smokecolors.png
    }

    affector Scaler{
        rate 10
    }

    affector Rotator{
        rotation_speed_range_start -20
        rotation_speed_range_end 30
        rotation_range_start 0
        rotation_range_end 200
    }

    affector DirectionRandomiser {
        randomness 1
    }
}


particle_system game/smokeParticle{
    billboard_type point
    particle_width 2
    particle_height 2
    quota 300
    material game/smoke

    emitter Point{
        direction 0 1 0
        position 0 0 0
        angle 120
        emission_rate 60
        time_to_live 1
        velocity_min 10
        velocity_max 30
        colour 0.65 0.65 0.65 0.95
        duration 5
    }

    affector ColourFader{
        red 0.06
        green 0.06
        blue 0.06
        alpha -0.06
    }

    affector Scaler{
        rate 10
    }
}
